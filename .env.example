# Server
PORT=3000
NODE_ENV=development

# External MySQL 8 service (Aiven, Railway, or another managed provider)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=63327221FGM
DB_NAME=batloung_farm_db
DB_CONNECTION_LIMIT=10
# Hosted MySQL should use TLS; set false only for local MySQL without TLS.
DB_SSL=true
# Optional PEM CA contents for providers that require certificate verification (e.g. Aiven VERIFY_IDENTITY).
# Supply the complete PEM as a protected environment variable; do not commit private keys or credentials.
DB_SSL_CA=

# Accounts live in the database. The first person to register becomes the admin.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# HTTPS Preview/production: true (SameSite=None; Secure). Set false only for localhost HTTP.
COOKIE_SECURE=true

# Optional comma-separated browser origins if the UI is hosted separately.
# Leave blank when UI and API are served from the same Express origin.
CORS_ORIGINS=
